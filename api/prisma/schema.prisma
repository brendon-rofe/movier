generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  libraryItems LibraryItem[]
  sentLinks        UserLink[] @relation("SentLinks")
  receivedLinks    UserLink[] @relation("ReceivedLinks")
  notifications    Notification[]
  sentNotifications Notification[] @relation("FromUser")
  ownedWatches     SharedWatch[] @relation("OwnedWatches")
  partneredWatches SharedWatch[] @relation("PartneredWatches")

  @@map("users")
}

model UserLink {
  id          Int      @id @default(autoincrement())
  requesterId Int
  requester   User     @relation("SentLinks", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  Int
  receiver    User     @relation("ReceivedLinks", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted | rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@map("user_links")
}

model Notification {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // invite_received | invite_accepted | watch_invite | watch_accepted
  fromUserId   Int
  fromUser     User     @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  message      String
  read         Boolean  @default(false)
  linkId       Int?
  sharedWatchId Int?
  createdAt    DateTime @default(now())

  @@map("notifications")
}

model SharedWatch {
  id         Int      @id @default(autoincrement())
  tmdbId     Int
  mediaType  String   // "movie" | "tv"
  title      String
  ownerId    Int
  partnerId  Int
  status     String   @default("pending") // pending | accepted | declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User @relation("OwnedWatches", fields: [ownerId], references: [id], onDelete: Cascade)
  partner User @relation("PartneredWatches", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([tmdbId, mediaType, ownerId, partnerId])
  @@map("shared_watches")
}

model LibraryItem {
  id          Int      @id @default(autoincrement())
  tmdbId      Int
  title       String
  overview    String   @db.Text
  posterPath  String?
  backdropPath String?
  voteAverage Float
  releaseDate String?
  mediaType   String   @default("movie") // "movie" | "tv"
  genreIds    String?  // JSON array stored as string

  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieTrack MovieTrack?
  tvTrack    TvTrack?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId, mediaType])
  @@map("library_items")
}

model MovieTrack {
  id     Int    @id @default(autoincrement())
  status String @default("want_to_watch") // want_to_watch | watching | watched | dropped

  libraryItemId Int @unique
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("movie_tracks")
}

model TvTrack {
  id       Int    @id @default(autoincrement())
  totalEpisodes Int @default(0)

  libraryItemId Int @unique
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  episodes  TvEpisode[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tv_tracks")
}

model TvEpisode {
  id           Int  @id @default(autoincrement())
  seasonNumber Int
  episodeNumber Int
  watched      Boolean @default(false)

  tvTrackId Int
  tvTrack   TvTrack @relation(fields: [tvTrackId], references: [id], onDelete: Cascade)

  @@unique([tvTrackId, seasonNumber, episodeNumber])
  @@map("tv_episodes")
}
